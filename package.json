{
  "name": "movie-archive",
  "version": "0.1.0",
  "description": "Movie, series and anime archive across several hard drives",
  "main": "src/main.js",
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.local.moviearchive",
    "productName": "Movie Archive",
    "files": [
      "src/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MohamadSoloki",
        "repo": "movie-archive"
      }
    ]
  }
}
