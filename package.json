{
  "name": "movie-archive",
  "version": "0.4.0",
  "description": "Movie, series and anime archive across several hard drives",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable --publish never --config.directories.output=dist/portable",
    "data:portable": "node scripts/portable-data.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fuse.js": "^7.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.local.moviearchive",
    "productName": "Movie Archive",
    "files": [
      "src/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "portable": {
      "artifactName": "Movie-Archive-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MohamadSoloki",
        "repo": "movie-archive",
        "releaseType": "release"
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "artifactName": "Movie-Archive-${version}.${ext}"
    }
  }
}
